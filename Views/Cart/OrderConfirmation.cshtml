@model CommUnityHub.Models.OrderHeader

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="card shadow-sm border-0 text-center py-5 my-4">
    <div class="card-body">
        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4.5rem;"></i>
        </div>
        <h2 class="fw-bold text-dark mb-2">Order Confirmed Successfully!</h2>
        <p class="text-muted fs-5 mb-4">
            Thank you, <strong>@Model.Name</strong>. Your service booking and materials request has been placed.
        </p>

        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card bg-light border text-start p-3 mb-4">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Order Reference:</span>
                        <strong class="text-primary">#@Model.Id</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Order Date:</span>
                        <span>@Model.OrderDate.ToString("dd MMM yyyy, HH:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Payment Status:</span>
                        <span class="badge bg-success">@Model.PaymentStatus</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Order Status:</span>
                        <span class="badge bg-primary">@Model.OrderStatus</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Fulfillment Address:</span>
                        <span>@Model.StreetAddress, @Model.City</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="fw-bold">Total Paid:</span>
                        <span class="fw-bold text-success fs-5">$@Model.OrderTotal.ToString("F2") NZD</span>
                    </div>
                </div>

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a asp-controller="Order" asp-action="Details" asp-route-orderId="@Model.Id" class="btn btn-primary px-4">
                        <i class="bi bi-box-seam me-1"></i>Track Order & Shipment
                    </a>
                    <a asp-controller="ServiceListings" asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-grid me-1"></i>Back to Services
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
