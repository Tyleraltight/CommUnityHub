@model CommUnityHub.Models.ViewModels.ShoppingCartVM

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white py-3">
        <div class="row align-items-center">
            <div class="col-6">
                <h5 class="mb-0"><i class="bi bi-cart3 me-2"></i>Shopping Cart</h5>
            </div>
            <div class="col-6 text-end">
                <a asp-controller="ServiceListings" asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Continue Browsing
                </a>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        @if (!Model.ShoppingCartList.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-cart-x text-muted" style="font-size: 3.5rem;"></i>
                <h4 class="mt-3 text-secondary">Your shopping cart is currently empty</h4>
                <p class="text-muted">Browse available community services and add booking deposits or materials to your cart.</p>
                <a asp-controller="ServiceListings" asp-action="Index" class="btn btn-primary mt-2">
                    <i class="bi bi-search me-1"></i>Find Local Services
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Service / Booking Item</th>
                            <th>Category</th>
                            <th class="text-center">Rate / Material Deposit</th>
                            <th class="text-center" style="width: 160px;">Quantity / Hours</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-center" style="width: 80px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ShoppingCartList)
                        {
                            <tr>
                                <td>
                                    <h6 class="mb-1 fw-bold">@item.ServiceListing?.Title</h6>
                                    <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@item.ServiceListing?.Suburb | Provider: @item.ServiceListing?.ProviderName</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.ServiceListing?.Category?.Name</span>
                                </td>
                                <td class="text-center">
                                    @if (item.Price > 0)
                                    {
                                        <span>$@item.Price.ToString("F2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-bold">Free Swap</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Minus" asp-route-cartId="@item.Id" class="btn btn-outline-secondary">
                                            <i class="bi bi-dash"></i>
                                        </a>
                                        <span class="btn btn-outline-secondary disabled fw-bold" style="min-width: 45px;">@item.Count</span>
                                        <a asp-action="Plus" asp-route-cartId="@item.Id" class="btn btn-outline-secondary">
                                            <i class="bi bi-plus"></i>
                                        </a>
                                    </div>
                                </td>
                                <td class="text-end fw-bold">
                                    $@((item.Price * item.Count).ToString("F2"))
                                </td>
                                <td class="text-center">
                                    <a asp-action="Remove" asp-route-cartId="@item.Id" class="btn btn-outline-danger btn-sm" title="Remove item">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row mt-4 pt-3 border-top align-items-center">
                <div class="col-md-6 mb-3 mb-md-0">
                    <div class="card bg-light border-0">
                        <div class="card-body p-3">
                            <small class="text-muted d-block">
                                <i class="bi bi-shield-check text-success me-1"></i>
                                <strong>Secure Checkout:</strong> Review your items and click Proceed to Checkout to confirm your booking.
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <h5 class="text-muted mb-1">Estimated Total:</h5>
                    <h2 class="fw-bold text-primary mb-3">$@Model.OrderHeader.OrderTotal.ToString("F2") NZD</h2>
                    <a asp-action="Summary" class="btn btn-success btn-lg px-4">
                        <i class="bi bi-credit-card me-2"></i>Proceed to Checkout
                    </a>
                </div>
            </div>
        }
    </div>
</div>
