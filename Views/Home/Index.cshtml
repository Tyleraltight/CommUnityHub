@model CommUnityHub.Models.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="p-4 p-md-5 mb-4 rounded text-bg-light border">
    <div class="col-md-8 px-0">
        <h1 class="display-5 fw-bold">CommUnity Hub</h1>
        <p class="lead my-3">
            A neighborhood platform connecting residents for skill sharing, mutual help, and community services in Wellington.
        </p>
        <p class="lead mb-0">
            <a asp-controller="ServiceListings" asp-action="Index" class="btn btn-primary btn-lg me-2">Browse Services</a>
            <a asp-controller="ServiceListings" asp-action="Create" class="btn btn-outline-secondary btn-lg">Offer a Skill</a>
        </p>
    </div>
</div>

<div class="row text-center mb-4">
    <div class="col-md-6 mb-2">
        <div class="card p-3 border-0 bg-light">
            <h3 class="fw-bold text-primary">@Model.TotalCategoriesCount</h3>
            <p class="text-muted mb-0">Active Service Categories</p>
        </div>
    </div>
    <div class="col-md-6 mb-2">
        <div class="card p-3 border-0 bg-light">
            <h3 class="fw-bold text-success">@Model.TotalListingsCount</h3>
            <p class="text-muted mb-0">Community Service Listings</p>
        </div>
    </div>
</div>

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Service Categories</h4>
        <a asp-controller="Categories" asp-action="Index" class="text-decoration-none">View All Categories &rarr;</a>
    </div>
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var cat in Model.FeaturedCategories)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            @if (!string.IsNullOrEmpty(cat.IconClass))
                            {
                                <i class="bi @cat.IconClass text-primary me-2"></i>
                            }
                            @cat.Name
                        </h5>
                        <p class="card-text text-muted small">@cat.Description</p>
                    </div>
                    <div class="card-footer bg-white border-top-0 pb-3">
                        <a asp-controller="ServiceListings" asp-action="Index" asp-route-categoryId="@cat.Id" class="btn btn-sm btn-outline-primary">
                            Browse Listings
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Recent Service Listings</h4>
        <a asp-controller="ServiceListings" asp-action="Index" class="text-decoration-none">View All Listings &rarr;</a>
    </div>
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var listing in Model.RecentListings)
        {
            <div class="col">
                <div class="card h-100 border">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <span class="badge bg-secondary mb-2">@listing.Category?.Name</span>
                            <span class="badge bg-info text-dark mb-2">@listing.ExchangeType</span>
                        </div>
                        <h5 class="card-title">@listing.Title</h5>
                        <p class="card-text text-muted small">@listing.Description</p>
                        <ul class="list-unstyled small mb-0 text-secondary">
                            <li><i class="bi bi-person me-1"></i> Provider: @listing.ProviderName</li>
                            <li><i class="bi bi-geo-alt me-1"></i> Suburb: @listing.Suburb</li>
                            @if (listing.DepositRequired)
                            {
                                <li class="text-warning-emphasis"><i class="bi bi-shield-check me-1"></i> Deposit / Materials: $@listing.EstimatedCost.ToString("F2")</li>
                            }
                        </ul>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                        <small class="text-muted">Posted: @listing.CreatedAt.ToString("dd MMM yyyy")</small>
                        <a asp-controller="ServiceListings" asp-action="Details" asp-route-id="@listing.Id" class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
