@model IEnumerable<CommUnityHub.Models.ServiceListing>

@{
    ViewData["Title"] = "Service Listings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Community Service Listings</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Post New Service
    </a>
</div>

<div class="card bg-light border-0 p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Category</label>
            <select name="categoryId" class="form-select form-select-sm" asp-items="ViewBag.Categories">
                <option value="">-- All Categories --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Suburb / Area</label>
            <input type="text" name="suburb" value="@ViewBag.CurrentSuburb" class="form-control form-control-sm" placeholder="e.g. Petone, Lower Hutt" />
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold">Keyword Search</label>
            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Search by title or description" />
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary w-100">
                <i class="bi bi-search"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Provider</th>
                        <th>Suburb</th>
                        <th>Exchange Type</th>
                        <th>Cost / Deposit</th>
                        <th>Status</th>
                        <th class="text-end pe-3 text-nowrap">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No service listings found matching your criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Title</strong>
                                <div class="text-muted small">@item.CreatedAt.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@item.Category?.Name</span>
                            </td>
                            <td>@item.ProviderName</td>
                            <td><i class="bi bi-geo-alt text-muted small"></i> @item.Suburb</td>
                            <td><span class="badge bg-info text-dark">@item.ExchangeType</span></td>
                            <td class="text-nowrap">
                                @if (item.DepositRequired)
                                {
                                    <span class="text-warning-emphasis fw-semibold">$@item.EstimatedCost.ToString("F2")</span>
                                }
                                else
                                {
                                    <span class="text-success small">Free Swap</span>
                                }
                            </td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Closed</span>
                                }
                            </td>
                            <td class="text-end text-nowrap pe-3">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">View</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
