@model CommUnityHub.Models.ServiceListing

@{
    ViewData["Title"] = "Delete Service Listing";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Confirm Delete Service Listing</h5>
            </div>
            <div class="card-body">
                <p class="text-danger fw-semibold">Are you sure you want to permanently delete this listing?</p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Title</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Title</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Category?.Name</span></dd>

                    <dt class="col-sm-4">Provider</dt>
                    <dd class="col-sm-8">@Model.ProviderName</dd>

                    <dt class="col-sm-4">Suburb</dt>
                    <dd class="col-sm-8">@Model.Suburb</dd>

                    <dt class="col-sm-4">Posted Date</dt>
                    <dd class="col-sm-8 text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
