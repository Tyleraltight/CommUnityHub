@model CommUnityHub.Models.ServiceCategory

@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Delete Category Confirmation</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.ListingCount > 0)
                {
                    <div class="alert alert-warning">
                        <strong>Warning:</strong> This category currently has <strong>@ViewBag.ListingCount</strong> active service listing(s). You must delete or reassign those listings before deleting this category.
                    </div>
                }
                else
                {
                    <p class="text-danger">Are you sure you want to permanently delete this category?</p>
                }

                <dl class="row mb-0">
                    <dt class="col-sm-4">Category Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8 text-muted">@Model.Description</dd>

                    <dt class="col-sm-4">Display Order</dt>
                    <dd class="col-sm-8">@Model.DisplayOrder</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@(Model.IsActive ? "Active" : "Inactive")</dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger" @(ViewBag.ListingCount > 0 ? "disabled" : "")>
                        Confirm Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
